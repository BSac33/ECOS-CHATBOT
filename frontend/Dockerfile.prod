# Image de production : frontend compilé (vue-tsc + vite) servi par nginx, qui relaie l'API.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.28-alpine
COPY connection_upgrade.conf /etc/nginx/conf.d/00-connection-upgrade.conf
COPY proxy_params.inc /etc/nginx/conf.d/proxy_params.inc
COPY security_headers.inc /etc/nginx/conf.d/security_headers.inc
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
