# Configuration du serveur de modèles (DMZ). Copier en .env (jamais versionné) puis éditer.

# Clé unique entre l'application et la passerelle. Générer : openssl rand -hex 32
# Côté application (fastapi.env) : VLLM_API_KEY = VLLM_ARBITER_API_KEY = KYUTAI_API_KEY = cette clé
MODELS_API_KEY=

# Adresse (ou réseau) du serveur de l'application, seul autorisé à joindre la passerelle.
# Ex. 10.20.30.40/32. Si le flux arrive par un NAT ou un reverse proxy de l'IHU, mettre son adresse.
APP_SERVER_CIDR=

# Port HTTPS publié par la passerelle
GATEWAY_PORT=443

# Mode vocal (Kyutai STT/TTS) : « voix » pour l'activer, vide pour ne servir que les LLM
COMPOSE_PROFILES=voix

# GPU (index nvidia-smi). Par défaut tout sur la même L40S 48 Go :
#   patient 0,55 (~26 Go) + arbitre 0,25 (~12 Go) + STT ~2,5 Go + TTS ~5,3 Go
# Avec deux GPU : PATIENT_GPU=0, ARBITER_GPU=1, VOICE_GPU=1 et PATIENT_GPU_MEMORY=0.85
PATIENT_GPU=0
ARBITER_GPU=0
VOICE_GPU=0
PATIENT_GPU_MEMORY=0.55
ARBITER_GPU_MEMORY=0.25

# Modèles (les noms doivent correspondre à VLLM_MODEL / VLLM_ARBITER_MODEL côté application)
PATIENT_MODEL=Qwen/Qwen3-8B
ARBITER_MODEL=Qwen/Qwen2.5-3B-Instruct
PATIENT_MAX_MODEL_LEN=32768

# Cache des poids (Hugging Face), partagé par tous les services : ~30 Go
HF_CACHE_DIR=./data/hf-cache
# Facultatif : les modèles utilisés sont publics
HUGGING_FACE_HUB_TOKEN=

# 1 = aucun accès sortant (poids et binaires déjà présents dans ./data, voir README)
OFFLINE=0

# Versions des images
VLLM_TAG=v0.11.0
NGINX_TAG=1.28-alpine
