# Configuration du serveur de modèles. Copier en .env (jamais versionné) puis éditer.

# Clé exigée par vLLM (et par la passerelle si elle est utilisée). Générer : openssl rand -hex 32
# Côté application (fastapi.env) : VLLM_API_KEY = VLLM_ARBITER_API_KEY = cette clé
MODELS_API_KEY=

# ---------- Mode d'accès ----------
# Mode direct (tests par VPN, ou nginx déjà en place sur la machine) : pas de passerelle,
# ports publiés uniquement sur MODELS_BIND.
COMPOSE_FILE=docker-compose.yml:docker-compose.direct.yml
# Adresse interne de cette machine, celle que vous joignez par le VPN (hostname -I).
# 127.0.0.1 si un nginx de la même machine relaie les modèles. Jamais 0.0.0.0.
MODELS_BIND=
PATIENT_PORT=8001
ARBITER_PORT=8002
STT_PORT=8090
TTS_PORT=8089

# Mode passerelle (HTTPS + clé + liste d'IP, certificats dans ./certs) : commenter les lignes
# COMPOSE_FILE et MODELS_BIND ci-dessus, ajouter « passerelle » à COMPOSE_PROFILES, et remplir :
APP_SERVER_CIDR=
GATEWAY_PORT=443

# Profils : « voix » = Kyutai STT/TTS (~8 Go de GPU de plus, compilation ~10 min au 1er démarrage),
# « passerelle » = nginx. Plusieurs : séparés par des virgules (ex. voix,passerelle).
COMPOSE_PROFILES=

# GPU (index nvidia-smi). Machine partagée : vérifier la mémoire libre avec nvidia-smi.
# Les fractions portent sur la mémoire TOTALE de la carte et doivent être libres au démarrage.
# Sur une L40S 48 Go dédiée : patient 0,55 (~26 Go) + arbitre 0,25 (~12 Go) + voix ~8 Go.
PATIENT_GPU=0
ARBITER_GPU=0
VOICE_GPU=0
PATIENT_GPU_MEMORY=0.55
ARBITER_GPU_MEMORY=0.25

# Modèles (les noms doivent correspondre à VLLM_MODEL / VLLM_ARBITER_MODEL côté application)
PATIENT_MODEL=Qwen/Qwen3-8B
ARBITER_MODEL=Qwen/Qwen2.5-3B-Instruct
PATIENT_MAX_MODEL_LEN=32768

# Cache des poids (Hugging Face), partagé par tous les services : ~30 Go.
# Réutiliser un cache existant évite de retélécharger.
HF_CACHE_DIR=./data/hf-cache
# Facultatif : les modèles utilisés sont publics
HUGGING_FACE_HUB_TOKEN=

# 1 = aucun accès sortant (poids et binaires déjà présents dans ./data, voir README)
OFFLINE=0

# Versions des images
VLLM_TAG=v0.11.0
NGINX_TAG=1.28-alpine
