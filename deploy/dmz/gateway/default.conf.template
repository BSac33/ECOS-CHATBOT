# Passerelle des modèles (DMZ). Gabarit : ${MODELS_API_KEY} et ${APP_SERVER_CIDR} sont remplacés
# au démarrage du conteneur nginx (NGINX_ENVSUBST_FILTER dans docker-compose.yml).
#
#   /patient/v1/...  -> vLLM patient   (Authorization: Bearer <clé>)
#   /arbitre/v1/...  -> vLLM arbitre   (Authorization: Bearer <clé>)
#   /stt/api/...     -> Kyutai STT     (WebSocket, en-tête kyutai-api-key: <clé>)
#   /tts/api/...     -> Kyutai TTS     (WebSocket, en-tête kyutai-api-key: <clé>)
#   /healthz         -> supervision de la passerelle (sans clé)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Une seule clé partagée avec le backend (VLLM_API_KEY, VLLM_ARBITER_API_KEY, KYUTAI_API_KEY)
map $http_authorization $bearer_ok {
    "Bearer ${MODELS_API_KEY}" 1;
    default 0;
}
map $http_kyutai_api_key $kyutai_ok {
    "${MODELS_API_KEY}" 1;
    default 0;
}

server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1h;

    # Seul le serveur de l'application (et la sonde locale) peut joindre les modèles
    allow 127.0.0.1;
    allow ${APP_SERVER_CIDR};
    deny all;

    # Résolution paresseuse (DNS de Docker) : la passerelle démarre même si un modèle est
    # absent ou encore en chargement (ex. profil « voix » désactivé) et répond alors 502.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Les transcriptions d'étudiants transitent ici : journal sans corps ni en-têtes (défaut nginx)
    client_max_body_size 10m;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---------- vLLM (API compatible OpenAI, réponses en flux) ----------
    location /patient/ {
        if ($bearer_ok = 0) { return 401; }
        set $upstream http://vllm-patient:8000;
        rewrite ^/patient(/.*)$ $1 break;
        proxy_pass $upstream;
        include /etc/nginx/snippets/vllm_proxy.inc;
    }

    location /arbitre/ {
        if ($bearer_ok = 0) { return 401; }
        set $upstream http://vllm-arbitre:8000;
        rewrite ^/arbitre(/.*)$ $1 break;
        proxy_pass $upstream;
        include /etc/nginx/snippets/vllm_proxy.inc;
    }

    # ---------- Kyutai (WebSocket ouvert pendant la prise de parole / la réplique) ----------
    location /stt/ {
        if ($kyutai_ok = 0) { return 401; }
        set $upstream http://stt:8080;
        rewrite ^/stt(/.*)$ $1 break;
        proxy_pass $upstream;
        include /etc/nginx/snippets/kyutai_proxy.inc;
    }

    location /tts/ {
        if ($kyutai_ok = 0) { return 401; }
        set $upstream http://tts:8080;
        rewrite ^/tts(/.*)$ $1 break;
        proxy_pass $upstream;
        include /etc/nginx/snippets/kyutai_proxy.inc;
    }

    location / {
        return 404;
    }
}
