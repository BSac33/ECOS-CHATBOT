# ============================================
# EXEMPLE DE CONFIGURATION POUR LA PRODUCTION
# ============================================
# Copiez ce fichier en fastapi.env et modifiez les valeurs selon votre environnement

# Modèles : serveur de la DMZ (deploy/dmz/), une seule clé = MODELS_API_KEY de deploy/dmz/.env
LLM_PROVIDER=vllm

# Patient simulé, évaluation, assistant de rédaction
VLLM_BASE_URL=https://modeles.ihu.local/patient/v1
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_API_KEY=changez_moi_cle_des_modeles
# Agent patient avec outils (examen clinique, documents, signalements) - voir docs/PATIENT_AGENT.md
PATIENT_AGENT_ENABLED=true
PATIENT_AGENT_TIMEOUT=30

# Correction automatique (même serveur que le patient) : délai par essai (3 essais), graine
EVALUATION_TIMEOUT=180
EVALUATION_SEED=1234

# Arbitre rapide des messages étudiants
VLLM_ARBITER_BASE_URL=https://modeles.ihu.local/arbitre/v1
VLLM_ARBITER_MODEL=Qwen/Qwen2.5-3B-Instruct
VLLM_ARBITER_API_KEY=changez_moi_cle_des_modeles
# Délai maximal de l'arbitre (secondes) ; au-delà, le message est accepté par défaut
ARBITER_TIMEOUT=2.0

# Mode vocal : serveurs Kyutai (docs/VOICE.md)
KYUTAI_STT_URL=wss://modeles.ihu.local/stt
KYUTAI_TTS_URL=wss://modeles.ihu.local/tts
KYUTAI_API_KEY=changez_moi_cle_des_modeles
# Voix utilisée quand le cas n'en précise pas (chemin dans le dépôt kyutai/tts-voices)
KYUTAI_TTS_DEFAULT_VOICE=unmute-prod-website/developpeuse-3.wav

# Certificat de la passerelle signé par une AC interne : bundle système + AC de l'IHU,
# monté dans le conteneur api (voir docs/DEPLOYMENT.md). Inutile avec un certificat public.
# SSL_CERT_FILE=/etc/ssl/ecos/ca-bundle.pem

# Assistant de rédaction des cas (bouton « Générer » de l'atelier) - voir docs/CASE_AUTHORING.md
# Serveur vLLM (API compatible OpenAI) ; vides = serveur vLLM du patient (VLLM_*)
AUTHORING_BASE_URL=
AUTHORING_MODEL=
AUTHORING_API_KEY=
AUTHORING_TIMEOUT=120

# Base de données PostgreSQL
# IMPORTANT : Utilisez un mot de passe fort en production
# Mêmes identifiants que postgres.env (service « database » de docker-compose.prod.yml)
DATABASE_URL=postgresql+psycopg2://ecos_chatbot:changez_moi@database:5432/ecos_chatbot_db

# AUTHENTICATION
# IMPORTANT : Générez une clé secrète forte et unique
# Utilisez : openssl rand -hex 32
SECRET_KEY=changez_moi_avec_une_cle_secrete_forte_et_unique
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
# CRITIQUE : Spécifiez uniquement les domaines de votre application en production
# Remplacez par vos URLs réelles (avec HTTPS)
CORS_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Cookie Security
# OBLIGATOIRE en production : Les cookies doivent être sécurisés (HTTPS uniquement)
SECURE_COOKIES=True

# Exploitation (docs/DEPLOYMENT.md, section 4)
LOG_LEVEL=INFO
# Documentation de l'API sur /docs : fermée en production
DOCS_ENABLED=false
# Connexions PostgreSQL par processus uvicorn (API_WORKERS × (taille + débord) < 100)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
