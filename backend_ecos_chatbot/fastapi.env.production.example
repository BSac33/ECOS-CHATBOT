# ============================================
# EXEMPLE DE CONFIGURATION POUR LA PRODUCTION
# ============================================
# Copiez ce fichier en fastapi.env et modifiez les valeurs selon votre environnement

# Configuration LLM Provider
LLM_PROVIDER=vllm
EVALUATION_PROVIDER=vllm

# API Gemini (si LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_production_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# vLLM Configuration (si LLM_PROVIDER=vllm)
VLLM_BASE_URL=http://your-vllm-server:8001/v1
VLLM_MODEL=Qwen/Qwen3-8B
# Agent patient avec outils (examen clinique, documents, signalements) - voir docs/PATIENT_AGENT.md
# Nécessite vLLM lancé avec --enable-auto-tool-choice --tool-call-parser hermes
PATIENT_AGENT_ENABLED=true
PATIENT_AGENT_TIMEOUT=30
VLLM_ARBITER_BASE_URL=http://10.33.35.222:8002/v1
VLLM_ARBITER_MODEL=Qwen/Qwen2.5-3B-Instruct
# Délai maximal de l'arbitre (secondes) ; au-delà, le message est accepté par défaut
ARBITER_TIMEOUT=2.0

# Mode vocal : serveurs Kyutai (voir voice/docker-compose.yml et docs/VOICE.md)
KYUTAI_STT_URL=ws://your-gpu-server:8090
KYUTAI_TTS_URL=ws://your-gpu-server:8089
KYUTAI_API_KEY=public_token
# Voix utilisée quand le cas n'en précise pas (chemin dans le dépôt kyutai/tts-voices)
KYUTAI_TTS_DEFAULT_VOICE=unmute-prod-website/developpeuse-3.wav

# Assistant de rédaction des cas (bouton « Générer » de l'atelier) - voir docs/CASE_AUTHORING.md
# Serveur vLLM (API compatible OpenAI) ; vides = serveur vLLM du patient (VLLM_*)
AUTHORING_BASE_URL=
AUTHORING_MODEL=
AUTHORING_API_KEY=
AUTHORING_TIMEOUT=120

# Base de données PostgreSQL
# IMPORTANT : Utilisez un mot de passe fort en production
DATABASE_URL=postgresql+psycopg2://user:password@database:5432/ecos

# AUTHENTICATION
# IMPORTANT : Générez une clé secrète forte et unique
# Utilisez : openssl rand -hex 32
SECRET_KEY=changez_moi_avec_une_cle_secrete_forte_et_unique
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
# CRITIQUE : Spécifiez uniquement les domaines de votre application en production
# Remplacez par vos URLs réelles (avec HTTPS)
CORS_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Cookie Security
# OBLIGATOIRE en production : Les cookies doivent être sécurisés (HTTPS uniquement)
SECURE_COOKIES=True
