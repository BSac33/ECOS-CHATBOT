# ============================================
# EXEMPLE DE CONFIGURATION POUR LA PRODUCTION
# ============================================
# Copiez ce fichier en fastapi.env et modifiez les valeurs selon votre environnement

# Configuration LLM Provider
LLM_PROVIDER=vllm
EVALUATION_PROVIDER=vllm

# API Gemini (si LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_production_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# vLLM Configuration (si LLM_PROVIDER=vllm)
#
# MODÈLE CHAT PATIENT  — roleplay + suivi de consignes de rôle
# OBLIGATOIREMENT un modèle *-Instruct (les modèles base ignorent le system prompt)
VLLM_BASE_URL=http://your-vllm-server:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# MODÈLE ÉVALUATION — sortie JSON structurée avec schéma Pydantic
# Si omis, utilise VLLM_BASE_URL / VLLM_MODEL (modèle chat partagé).
# Définir ici pour dédier un modèle Instruct plus grand à l'évaluation.
# VLLM_EVAL_BASE_URL=http://your-vllm-server:8001/v1
# VLLM_EVAL_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# ARBITRE  — classifieur déterministe par mots-clés (pas de modèle LLM nécessaire)
# Les petits modèles (1.5B, 3B) génèrent trop de faux positifs sur les questions
# cliniques (traitements, médicaments...) et bloquent l'examen à tort.
# Le classifieur Python intégré est instantané, sans faux positifs, et couvre
# tous les cas d'abus réels (insultes, exfiltration grille/prompt).

# Base de données PostgreSQL
# IMPORTANT : Utilisez un mot de passe fort en production
DATABASE_URL=postgresql+psycopg2://user:password@database:5432/ecos

# AUTHENTICATION
# IMPORTANT : Générez une clé secrète forte et unique
# Utilisez : openssl rand -hex 32
SECRET_KEY=changez_moi_avec_une_cle_secrete_forte_et_unique
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
# CRITIQUE : Spécifiez uniquement les domaines de votre application en production
# Remplacez par vos URLs réelles (avec HTTPS)
CORS_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

# Cookie Security
# OBLIGATOIRE en production : Les cookies doivent être sécurisés (HTTPS uniquement)
SECURE_COOKIES=True
